{
  "name": "landl-sourdough",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "PLAYWRIGHT_BASE_URL=https://www.landlsourdough.com playwright test",
    "smoke:live": "npm run check:domain && npm run test:e2e:live",
    "check:domain": "node scripts/check-domain.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-deployment.mjs",
    "check:prod-env": "node scripts/check-production-env.mjs",
    "check:seed": "node scripts/check-seed.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "validate": "npm run cf:typegen && npm run lint && npm run check:seed && npm run check:assets && npm test && npm run check:server-client-lifecycle && npm run test:e2e && npm run build",
    "stripe:sync-catalog": "node scripts/sync-stripe-catalog.mjs",
    "delivery:align-sunday": "node scripts/align-sunday-delivery.mjs",
    "bread-club:daily": "node scripts/run-bread-club-daily.mjs",
    "bread-club:setup": "node scripts/setup-bread-club.mjs",
    "build:cloudflare": "npm run cf:typegen && opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:cron": "wrangler deploy --config wrangler.cron.jsonc",
    "cf:typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-main-module=false && wrangler types cloudflare-cron-env.d.ts --config wrangler.cron.jsonc --env-interface BakeryCronEnv --include-runtime=false --include-main-module=false",
    "check:server-client-lifecycle": "node --expose-gc --experimental-strip-types scripts/check-server-client-lifecycle.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "16.4.6",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "@opennextjs/cloudflare": "1.20.17",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.22"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.13"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
