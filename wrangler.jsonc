{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landl-sourdough",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.landlsourdough.com",
      "custom_domain": true,
      "zone_id": "13ff9a70e6f36a73f21f90e68d239972"
    },
    {
      "pattern": "landlsourdough.com",
      "custom_domain": true,
      "zone_id": "13ff9a70e6f36a73f21f90e68d239972"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "landl-sourdough" }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "landl-sourdough-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "landl-sourdough-cache-tags",
      "database_id": "51e74e11-f1a0-4f56-8fe2-489038a0bb51"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "images": { "binding": "IMAGES" },
  "vars": {
    "DEPLOYMENT_PLATFORM": "cloudflare"
  },
  "secrets": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "CRON_SECRET"
    ]
  },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
